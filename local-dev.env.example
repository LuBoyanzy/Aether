# Beszel 本地开发环境变量示例
# 复制为 `local-dev.env` 后按本机环境修改。

# Hub: PostgreSQL formal ingest monitor
AETHER_HUB_INGEST_MONITOR_PG_HOST=127.0.0.1
AETHER_HUB_INGEST_MONITOR_PG_PORT=48300
AETHER_HUB_INGEST_MONITOR_PG_USER=app_user
AETHER_HUB_INGEST_MONITOR_PG_PASSWORD=dev-only-postgres-pass
AETHER_HUB_INGEST_MONITOR_PG_DATABASE=i3d_multitenant
AETHER_HUB_INGEST_MONITOR_PG_TENANT=guochuang
AETHER_HUB_INGEST_MONITOR_PG_SSLMODE=disable

# Hub: generic local dev
AETHER_HUB_DATA_CLEANUP_KEY=0123456789abcdef0123456789abcdef
BESZEL_HOST_PORT=19100
APP_URL=http://127.0.0.1:19100

# Legacy offline license module. Current i3d Docker release does not require
# model decryption/license keys for loading models, so keep these unset unless
# that old Aether license workflow is explicitly enabled again.
# AETHER_HUB_LICENSE_PRIVATE_KEY_FILE=/path/to/license_signing_ed25519_private.pem
# AETHER_HUB_LICENSE_MODEL_MANIFEST=/path/to/model_security_manifest.json

# Agent local dev
AETHER_AGENT_LOG_LEVEL=debug
HUB_URL=http://127.0.0.1:19100

# 如果你希望把 Agent 的 KEY / TOKEN 也放到本地文件里，可自行取消注释并填写。
# KEY="ssh-ed25519 ..."
# TOKEN=...
